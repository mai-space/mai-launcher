<?xml version="1.0" encoding="utf-8"?>
<!-- Kein Cloud-Backup und keine Geräteübertragung: Daten bleiben lokal.
     Sicherungen nur über den eigenen, verschlüsselten Export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
